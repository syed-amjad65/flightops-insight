# Vertex AI environment template. Copy to .env and fill from Secret Manager.
FLIGHTOPS_ROOT=/app
FLIGHTOPS_CONFIG=/app/config.yaml
MODEL_VERSION=prototype-0.1.0
GCP_PROJECT=your-project
GCP_REGION=europe-west1
PIPELINE_ROOT=gs://your-bucket/flightops/pipelines
RAW_DATA_URI=gs://your-bucket/flightops/raw
PROCESSED_DATA_URI=gs://your-bucket/flightops/processed

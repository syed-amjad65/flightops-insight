# Copy to .streamlit/secrets.toml (git-ignored) and fill from your identity
# provider. Never commit the real file. The app enables the login gate
# automatically when this [auth] section is complete.
#
# Authlib is required:  pip install "streamlit[auth]"
#
# Google example (replace the placeholders):
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "generate-with: python -c \"import secrets; print(secrets.token_urlsafe(48))\""
# client_id = "REPLACE_ME"
# client_secret = "REPLACE_ME"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
# client_kwargs = { prompt = "select_account" }
#
# Microsoft example:
# server_metadata_url = "https://login.microsoftonline.com/{tenant}/v2.0/.well-known/openid-configuration"
#
# Okta example:
# server_metadata_url = "https://{subdomain}.okta.com/.well-known/openid-configuration"
#
# Optional: expose tokens only if the app must call another API on the user's
# behalf. The app does not need them today.
# expose_tokens = "id"
